# Copia este archivo como .env.local para desarrollo. No subas nunca .env.local a GitHub.
# En Vercel, añade estas variables en Settings > Environment Variables.

# Activa la generación con búsqueda web actualizada.
OPENAI_API_KEY=

# Añade lugares e imágenes de OpenTripMap. La app funciona sin esta variable.
OPENTRIPMAP_API_KEY=

# Opcional: contraseña sencilla para evitar que una demo pública consuma la API.
DEMO_ACCESS_CODE=
